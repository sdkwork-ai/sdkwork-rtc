{
  "provider": "twilio",
  "displayName": "Twilio Video",
  "description": "Twilio Programmable Video实时音视频提供方（适配器待接入）",
  "adapterStatus": "planned",
  "accountFields": [
    {"key": "externalTenantId", "label": "Twilio Account SID", "type": "string", "required": false}
  ],
  "applicationFields": [
    {"key": "providerApplicationId", "label": "API Key SID", "type": "string", "required": true, "placeholder": "如 SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"},
    {"key": "providerApplicationIdKind", "label": "应用ID类型", "type": "enum", "values": ["twilio_api_key_sid"], "default": "twilio_api_key_sid", "hidden": true},
    {"key": "accessEndpoint", "label": "接入端点", "type": "string", "default": "wss://rtc.twilio.local/session", "required": false},
    {"key": "apiEndpoint", "label": "API端点", "type": "string", "default": "https://video.twilio.com"},
    {"key": "apiHost", "label": "API主机", "type": "string", "default": "video.twilio.com"},
    {"key": "apiVersion", "label": "API版本", "type": "string", "default": "v1"}
  ],
  "credentialRoles": [
    {
      "role": "rtc_token_signing",
      "label": "RTC Token签名",
      "description": "用于生成参与者凭证(Twilio Access Token)",
      "fields": [
        {"key": "credentialRef", "label": "API Key Secret", "type": "secret_ref", "required": true, "placeholder": "secret://rtc/twilio/api-key-secret"}
      ]
    },
    {
      "role": "cloud_api_signing",
      "label": "云API签名",
      "description": "用于调用Twilio REST API(Active Query)",
      "fields": [
        {"key": "credentialRef", "label": "Account SID", "type": "secret_ref", "required": true, "placeholder": "secret://rtc/twilio/account-sid"},
        {"key": "credentialFingerprint", "label": "Auth Token", "type": "secret_ref", "required": true, "placeholder": "secret://rtc/twilio/auth-token"}
      ]
    },
    {
      "role": "webhook_signing",
      "label": "Webhook签名",
      "description": "用于验证Webhook回调签名",
      "fields": [
        {"key": "credentialRef", "label": "Webhook密钥", "type": "secret_ref", "required": false, "placeholder": "secret://rtc/twilio/webhook"}
      ]
    }
  ],
  "profileFields": [
    {"key": "providerAppId", "label": "API Key SID", "type": "string", "required": true},
    {"key": "endpoint", "label": "接入端点", "type": "string", "default": "wss://rtc.twilio.local/session"},
    {"key": "region", "label": "区域", "type": "enum", "values": ["gll"], "default": "gll"},
    {"key": "credentialTtlSeconds", "label": "凭证有效期(秒)", "type": "number", "default": 3600, "min": 300, "max": 86400}
  ],
  "optionalCapabilities": ["recording", "artifact", "screen-share", "cloud-mix", "data-channel"],
  "requiredCapabilities": ["session", "credential", "provider.webhook", "health", "media.audio", "media.video", "live.broadcast", "live.audience", "provider.event-normalization"]
}
