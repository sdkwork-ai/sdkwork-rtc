{
  "provider": "daily",
  "displayName": "Daily.co RTC",
  "description": "Daily.co实时音视频提供方（适配器待接入）",
  "adapterStatus": "planned",
  "accountFields": [
    {"key": "externalTenantId", "label": "Daily域ID", "type": "string", "required": false}
  ],
  "applicationFields": [
    {"key": "providerApplicationId", "label": "API Key", "type": "string", "required": true, "placeholder": "如 daily-api-key-001"},
    {"key": "providerApplicationIdKind", "label": "应用ID类型", "type": "enum", "values": ["daily_api_key"], "default": "daily_api_key", "hidden": true},
    {"key": "accessEndpoint", "label": "接入端点", "type": "string", "default": "wss://rtc.daily.local/session", "required": false},
    {"key": "apiEndpoint", "label": "API端点", "type": "string", "default": "https://api.daily.co"},
    {"key": "apiHost", "label": "API主机", "type": "string", "default": "api.daily.co"},
    {"key": "apiVersion", "label": "API版本", "type": "string", "default": "v1"}
  ],
  "credentialRoles": [
    {
      "role": "rtc_token_signing",
      "label": "RTC Token签名",
      "description": "用于生成参与者凭证(Daily Meeting Token)",
      "fields": [
        {"key": "credentialRef", "label": "API Key", "type": "secret_ref", "required": true, "placeholder": "secret://rtc/daily/api-key"}
      ]
    },
    {
      "role": "webhook_signing",
      "label": "Webhook签名",
      "description": "用于验证Webhook回调签名",
      "fields": [
        {"key": "credentialRef", "label": "Webhook密钥", "type": "secret_ref", "required": false, "placeholder": "secret://rtc/daily/webhook"}
      ]
    }
  ],
  "profileFields": [
    {"key": "providerAppId", "label": "API Key", "type": "string", "required": true},
    {"key": "endpoint", "label": "接入端点", "type": "string", "default": "wss://rtc.daily.local/session"},
    {"key": "region", "label": "区域", "type": "enum", "values": ["global"], "default": "global"},
    {"key": "credentialTtlSeconds", "label": "凭证有效期(秒)", "type": "number", "default": 3600, "min": 300, "max": 86400}
  ],
  "optionalCapabilities": ["recording", "artifact", "screen-share", "cloud-mix", "data-channel"],
  "requiredCapabilities": ["session", "credential", "provider.webhook", "health", "media.audio", "media.video", "live.broadcast", "live.audience", "provider.event-normalization"]
}
