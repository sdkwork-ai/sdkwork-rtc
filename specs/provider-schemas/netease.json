{
  "provider": "netease",
  "displayName": "网易云信 RTC",
  "description": "网易云信NERTC实时音视频提供方（适配器待接入）",
  "adapterStatus": "planned",
  "accountFields": [
    {"key": "externalTenantId", "label": "云信账号ID", "type": "string", "required": false}
  ],
  "applicationFields": [
    {"key": "providerApplicationId", "label": "AppKey", "type": "string", "required": true, "placeholder": "如 netease-rtc-appkey-001"},
    {"key": "providerApplicationIdKind", "label": "应用ID类型", "type": "enum", "values": ["netease_app_key"], "default": "netease_app_key", "hidden": true},
    {"key": "accessEndpoint", "label": "接入端点", "type": "string", "default": "wss://rtc.netease.local/session", "required": false},
    {"key": "apiEndpoint", "label": "API端点", "type": "string", "default": "https://api.netease.im"},
    {"key": "apiHost", "label": "API主机", "type": "string", "default": "api.netease.im"},
    {"key": "apiVersion", "label": "API版本", "type": "string", "default": "v1"}
  ],
  "credentialRoles": [
    {
      "role": "rtc_token_signing",
      "label": "RTC Token签名",
      "description": "用于生成参与者凭证(NERTC Token)",
      "fields": [
        {"key": "credentialRef", "label": "App Secret", "type": "secret_ref", "required": true, "placeholder": "secret://rtc/netease/app-secret"}
      ]
    },
    {
      "role": "cloud_api_signing",
      "label": "云API签名",
      "description": "用于调用云信服务端API(Active Query)",
      "fields": [
        {"key": "credentialRef", "label": "App Secret", "type": "secret_ref", "required": true, "placeholder": "secret://rtc/netease/api-secret"}
      ]
    },
    {
      "role": "webhook_signing",
      "label": "Webhook签名",
      "description": "用于验证Webhook回调签名",
      "fields": [
        {"key": "credentialRef", "label": "Webhook密钥", "type": "secret_ref", "required": false, "placeholder": "secret://rtc/netease/webhook"}
      ]
    }
  ],
  "profileFields": [
    {"key": "providerAppId", "label": "AppKey", "type": "string", "required": true},
    {"key": "endpoint", "label": "接入端点", "type": "string", "default": "wss://rtc.netease.local/session"},
    {"key": "region", "label": "区域", "type": "enum", "values": ["cn-east-1", "cn-north-1"], "default": "cn-east-1"},
    {"key": "credentialTtlSeconds", "label": "凭证有效期(秒)", "type": "number", "default": 3600, "min": 300, "max": 86400}
  ],
  "optionalCapabilities": ["recording", "artifact", "screen-share", "cloud-mix", "provider.active-query"],
  "requiredCapabilities": ["session", "credential", "provider.webhook", "health", "media.audio", "media.video", "live.broadcast", "live.audience", "provider.event-normalization"]
}
