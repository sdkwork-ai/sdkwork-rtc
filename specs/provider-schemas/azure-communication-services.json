{
  "provider": "azure-communication-services",
  "displayName": "Azure Communication Services",
  "description": "Azure Communication Services实时音视频提供方（适配器待接入）",
  "adapterStatus": "planned",
  "accountFields": [
    {"key": "externalTenantId", "label": "Azure订阅ID", "type": "string", "required": false},
    {"key": "cloudAccountId", "label": "资源组", "type": "string", "required": false}
  ],
  "applicationFields": [
    {"key": "providerApplicationId", "label": "资源端点", "type": "string", "required": true, "placeholder": "如 https://rtc-acs.communication.azure.com"},
    {"key": "providerApplicationIdKind", "label": "应用ID类型", "type": "enum", "values": ["azure_acs_resource_endpoint"], "default": "azure_acs_resource_endpoint", "hidden": true},
    {"key": "accessEndpoint", "label": "接入端点", "type": "string", "default": "wss://rtc.azure.local/session", "required": false},
    {"key": "apiEndpoint", "label": "API端点", "type": "string", "default": "https://rtc-acs.communication.azure.com"},
    {"key": "apiHost", "label": "API主机", "type": "string", "default": "rtc-acs.communication.azure.com"},
    {"key": "apiVersion", "label": "API版本", "type": "string", "default": "2023-10-01"}
  ],
  "credentialRoles": [
    {
      "role": "rtc_token_signing",
      "label": "RTC Token签名",
      "description": "用于生成参与者凭证(ACS User Access Token)",
      "fields": [
        {"key": "credentialRef", "label": "Access Key", "type": "secret_ref", "required": true, "placeholder": "secret://rtc/azure-communication-services/access-key"}
      ]
    },
    {
      "role": "cloud_api_signing",
      "label": "云API签名",
      "description": "用于调用ACS REST API(HMAC, Active Query)",
      "fields": [
        {"key": "credentialRef", "label": "Access Key", "type": "secret_ref", "required": true, "placeholder": "secret://rtc/azure-communication-services/api-access-key"}
      ]
    },
    {
      "role": "webhook_signing",
      "label": "Webhook签名",
      "description": "用于验证Event Grid回调签名",
      "fields": [
        {"key": "credentialRef", "label": "Webhook密钥", "type": "secret_ref", "required": false, "placeholder": "secret://rtc/azure-communication-services/webhook"}
      ]
    }
  ],
  "profileFields": [
    {"key": "providerAppId", "label": "资源端点", "type": "string", "required": true},
    {"key": "endpoint", "label": "接入端点", "type": "string", "default": "wss://rtc.azure.local/session"},
    {"key": "region", "label": "区域", "type": "enum", "values": ["global"], "default": "global"},
    {"key": "credentialTtlSeconds", "label": "凭证有效期(秒)", "type": "number", "default": 3600, "min": 300, "max": 86400}
  ],
  "optionalCapabilities": ["recording", "artifact", "screen-share", "cloud-mix", "data-channel"],
  "requiredCapabilities": ["session", "credential", "provider.webhook", "health", "media.audio", "media.video", "live.broadcast", "live.audience", "provider.event-normalization"]
}
