# standalone.production
SDKWORK_RTC_DEPLOYMENT_PROFILE=standalone
SDKWORK_RTC_ENVIRONMENT=production
SDKWORK_RTC_PROFILE_ID=standalone.production

# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_RTC_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

SDKWORK_RTC_APPLICATION_PUBLIC_INGRESS_BIND=0.0.0.0:18088
SDKWORK_RTC_APPLICATION_PUBLIC_HTTP_URL=http://127.0.0.1:18088

VITE_SDKWORK_RTC_PC_DEPLOYMENT_PROFILE=standalone
VITE_SDKWORK_RTC_PC_APPLICATION_PUBLIC_HTTP_URL=http://127.0.0.1:18088
VITE_SDKWORK_RTC_H5_DEPLOYMENT_PROFILE=standalone
VITE_SDKWORK_RTC_H5_APPLICATION_PUBLIC_HTTP_URL=http://127.0.0.1:18088

SDKWORK_RTC_PC_STATIC_ROOT=/usr/share/sdkwork/rtc/web/pc
SDKWORK_CORS_ALLOWED_ORIGINS=https://rtc.sdkwork.com,https://rtc.birdcoder.com,https://rtc.dtupay.com,https://rtc.noaper.com,https://rtc.sdkwork.cn,https://rtc.birdcoder.cn,https://rtc.dtupay.cn,https://rtc.noaper.cn,https://rtc.skubc.com,https://rtc.skubc.cn,https://rtc.zowalk.com,https://rtc.zowalk.cn,https://rtc.offer86.com,https://rtc.offer86.cn,https://rtc.86offer.com,https://rtc.86offer.cn,app://dsh,app://birdcoder,app://sdkwork,app://dtupay,tauri://localhost,https://servicewechat.com
